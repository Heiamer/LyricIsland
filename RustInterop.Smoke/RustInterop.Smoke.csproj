<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RustInterop.Smoke</AssemblyName>
    <RootNamespace>RustInterop.Smoke</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarLyrics.Core\TaskbarLyrics.Core.csproj" />
  </ItemGroup>

  <!-- Keep the demo runnable even if the transitive copy of the native library is skipped. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\Rust\artifacts\lyric_ffi.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Rust\artifacts\lyric_ffi.dll')">
      <Link>lyric_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
