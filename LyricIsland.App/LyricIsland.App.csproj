<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\LyricIsland-v2.ico</ApplicationIcon>
    <AssemblyName>LyricIsland</AssemblyName>
    <Version>1.0.0</Version>
    <UseRustBackend Condition="'$(UseRustBackend)' == ''">true</UseRustBackend>
    <DefineConstants Condition="'$(UseRustBackend)' == 'true'">$(DefineConstants);RUST_BACKEND</DefineConstants>
    <StartupObject>LyricIsland.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseRustBackend)' == 'false'"><ProjectReference Include="..\TaskbarLyrics.Core\TaskbarLyrics.Core.csproj" /><Compile Remove="NativeFrontend\**\*.cs" /></ItemGroup>
  <ItemGroup Condition="'$(UseRustBackend)' == 'true'">
    <ProjectReference Include="..\TaskbarLyrics.GuiContracts\TaskbarLyrics.GuiContracts.csproj" />
    <Compile Remove="MusicEngine.cs;PlaybackClock.cs;TrackArtworkResolver.cs;TrackDurationResolver.cs;NeteaseFavorite.cs;StartupRegistration.cs;SettingsServer.cs;SettingsProtocol.cs;Program.cs;IslandSettings.cs;PlaybackDiagnostics.cs;RealPlaybackSmoke.cs;DirectNetworkSmoke.cs;Media\**\*.cs" />
    <Compile Include="Media\MediaHotkeyAction.cs" />
  </ItemGroup>
  <ItemGroup><Content Include="Assets\LyricIsland-v2.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="Assets\Fonts\OPPOSans.ttf" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
