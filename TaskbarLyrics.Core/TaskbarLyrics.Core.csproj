<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="F23.StringSimilarity" Version="7.0.1" />
    <PackageReference Include="Lyricify.Lyrics.Helper" Version="0.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="OpenCC" Version="0.1.0" />
  </ItemGroup>

  <!--
    Rust lyric engine (Rust/crates/lyric-ffi -> lyric_ffi.dll).

    The Condition keeps the build working when the native library has not been built yet:
    RustLyricEngine then reports itself unavailable and the original C# implementation is
    used, exactly as before. Build it with `..\build-rust.cmd` (it also copies the DLL to
    Rust\artifacts\lyric_ffi.dll, which is what this item picks up).
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\Rust\artifacts\lyric_ffi.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Rust\artifacts\lyric_ffi.dll')">
      <Link>lyric_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
